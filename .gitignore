# LightFringe source snapshot and LF-NEXT-P2 development paths.
# Root-relative exceptions preserve package and fixture paths.
# Ignore rules do not untrack files and cannot prevent forced staging.
# Lower-level ignore files, attributes and content filters require separate verification.
#
# Default deny applies outside the file types and paths opened below.
*

# Root launch, dependency and Git controls, plus maintenance Markdown.
!/.gitattributes
!/.gitignore
!/*.md
!/requirements-a4.txt
!/run.cmd
!/run.ps1
!/runtime-a4.json

# Product and test Python sources, including nested packages.
!/lightfringe/
!/lightfringe/**/
!/lightfringe/**/*.py
!/lightfringe/assets/LightFringe.ico
!/tests/
!/tests/**/
!/tests/**/*.py

# Maintenance Markdown and scientific reference data in their own trees.
!/docs/
!/docs/**/
!/docs/**/*.md
!/docs/images/multi-aperture.png
!/docs/images/classic-experiment.png
!/references/
!/references/**/
!/references/**/*.md
!/references/**/*.json
!/references/**/*.csv
!/references/**/*.npz

# Eight active fixtures: open all ancestors, then only exact input files.
!/artifacts/
!/artifacts/LF-P0-A2-R1/
!/artifacts/LF-P0-A2-R1/baseline/
!/artifacts/LF-P0-A2-R1/baseline/lightfringe/
!/artifacts/LF-P0-A3-MULTISLIT-R1/
!/artifacts/LF-P0-A3-MULTISLIT-R1/baseline/
!/artifacts/LF-P0-A3-MULTISLIT-R1/baseline/lightfringe/
!/artifacts/LF-P0-A2-R1/BEGIN_nominal_outputs.json
!/artifacts/LF-P0-A2-R1/baseline/lightfringe/model.py
!/artifacts/LF-P0-A2-R1/baseline/lightfringe/rendering.py
!/artifacts/LF-P0-A2-R1/baseline/lightfringe/sampling.py
!/artifacts/LF-P0-A3-MULTISLIT-R1/BEGIN_nominal_outputs.json
!/artifacts/LF-P0-A3-MULTISLIT-R1/baseline/lightfringe/model.py
!/artifacts/LF-P0-A3-MULTISLIT-R1/baseline/lightfringe/rendering.py
!/artifacts/LF-P0-A3-MULTISLIT-R1/baseline/lightfringe/sampling.py

# Three minimal project-control indexes, not live audit/control storage.
!/project-control/
!/project-control/BASELINE-394-MAP.csv
!/project-control/BASELINE-LINK.json
!/project-control/SCIENCE-REFERENCE-REGISTER.csv

# Packaging boundary documentation only; no generated build files.
!/packaging/
!/packaging/README.md

# Local environments and task outputs stay ignored inside admitted trees.
.venv/
venv/
env/
.conda/
conda-meta/
site-packages/
A4-R1/
A4-BUILD-R1/
_Envs/
_Candidates/
_Audits/
_local-dev/
local-build/
next-work/

# Python/tool caches and native/build products at any depth.
# Native suffix case is explicit.
__pycache__/
*.py[cod]
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
*.egg-info/
.coverage
htmlcov/
build/
dist/
*.build/
*.dist/
*.onefile-build/
*.spec
*.whl
*.[dD][lL][lL]
*.[pP][yY][dD]
*.[eE][xX][eE]
*.[oO][bB][jJ]
*.[lL][iI][bB]
*.[eE][xX][pP]
*.[iI][lL][kK]
*.[pP][dD][bB]

# Temporary files and user/editor configuration at any depth.
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.env
.env.*
*.local
*.local.*
*.private.*
secrets/
credentials/
secrets.json
credentials.json
client_secret*.json
.idea/
.vscode/

# Credentials in the scientific reference tree.
/references/**/credentials.*
/references/**/.credentials.*
/references/**/secrets.*
/references/**/.secrets.*
/references/**/service[-_]account.json
/references/**/service[-_]account[-_.]*.json

# Accidental task/audit/control copies are never seed authority or source inputs.
/run-output/
/task-output/
/LPM/
/transactions/
/journal/
/CURRENT.json
/PROJECT-STATE.json

# Local build configuration and generated output remain excluded.
build-roots.local.json
build-output/
# Exact additions approved for LF-SOURCE-RELEASE-SNAPSHOT-R1 (spec exception follows *.spec).
!/packaging/gui-r1/
!/packaging/gui-r1/hooks/
!/LICENSE
!/packaging/gui-r1/README.md
!/packaging/gui-r1/LightFringe.spec
!/packaging/gui-r1/launcher.py
!/packaging/gui-r1/early-origin-hook.py
!/packaging/gui-r1/lfdiagnostics.py
!/packaging/gui-r1/releasechecks.py
!/packaging/gui-r1/version-resource.txt
!/packaging/gui-r1/hooks/hook-PySide6.QtGui.py
!/packaging/gui-r1/build-roots.example.json
